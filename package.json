{
  "name": "diary-vue",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "health:check": "tsx scripts/health-check.ts",
    "health:full": "tsx scripts/health-check.ts && npm run build",
    "health:quick": "npm test && npx prisma validate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nuxt/icon": "^2.2.1",
    "@nuxtjs/mdc": "^0.20.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.3",
    "nuxt": "^4.3.1",
    "prisma": "^5.22.0",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.0.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "happy-dom": "^20.5.0",
    "husky": "^9.1.7",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  }
}
