  "about": {
    "hero": {
      "title": "個人投資日記",
      "subtitle": "一個為個人投資管理而生的自用專案"
    },
    "intro": {
      "title": "專案介紹",
      "content": "這是一個個人開發的投資日記系統，專為記錄個人投資決策、交易紀錄與市場洞察而設計。作為一個自用專案，它融合了實際投資需求與現代化開發技術，提供簡潔而強大的功能。"
    },
    "motivation": {
      "title": "開發動機",
      "paragraph1": "在長期的投資過程中，我發現系統化記錄交易決策與反思對投資成長至關重要。市面上雖有許多投資管理工具，但大多過於複雜或缺乏個人化功能。",
      "paragraph2": "因此，我決定開發一個符合個人需求的投資日記系統，既能記錄交易決策，又能追蹤投資績效，並提供即時提醒功能，幫助自己在投資路上不斷學習與進步。"
    },
    "features": {
      "title": "主要功能",
      "subtitle": "為個人投資管理量身打造的功能",
      "diary": {
        "title": "投資日記",
        "description": "使用 Markdown 語法撰寫詳細的投資日記，記錄交易理由、市場分析與個人反思，建立完整的投資決策記錄。"
      },
      "calendar": {
        "title": "月曆視圖",
        "description": "以月曆形式展示所有投資活動，直觀查看每日的交易、日記與提醒，快速定位特定日期的投資紀錄。"
      },
      "timeline": {
        "title": "時間軸",
        "description": "按時間順序瀏覽所有投資記錄，從時間軸中發現投資模式與決策變化，回顧投資歷程。"
      },
      "stocks": {
        "title": "股票管理",
        "description": "追蹤股票持倉、計算平均成本，使用 FIFO 先進先出法精確計算損益，掌握投資績效。"
      },
      "alerts": {
        "title": "提醒系統",
        "description": "設定時間觸發的個人提醒，確保不會錯過重要的交易時機或市場事件。"
      },
      "discipline": {
        "title": "交易紀律",
        "description": "追蹤交易頻率與紀律，設定個人交易目標，幫助維持穩定的投資策略。"
      },
      "security": {
        "title": "資料安全",
        "description": "使用 JWT 身份驗證與 bcrypt 密碼加密，確保個人投資數據的隱私與安全。"
      }
    },
    "tech": {
      "title": "技術實現",
      "subtitle": "使用現代化技術堆疊開發"
    },
    "personal": {
      "title": "個人專案特色",
      "content": "作為一個個人自用專案，系統專注於實用性而非商業化。沒有廣告、沒有數據收集、沒有不必要的功能，只有純粹的投資管理工具。所有功能都基於實際投資需求開發，持續優化與改進。"
    },
    "footer": {
      "rights": "個人專案，保留所有權利"
    }
