  "about": {
    "hero": {
      "title": "个人投资日记",
      "subtitle": "一个为个人投资管理而生的自用项目"
    },
    "intro": {
      "title": "项目介绍",
      "content": "这是一个个人开发的投资日记系统，专为记录个人投资决策、交易纪录与市场洞察而设计。作为一个自用项目，它融合了实际投资需求与现代化开发技术，提供简洁而强大的功能。"
    },
    "motivation": {
      "title": "开发动机",
      "paragraph1": "在长期的投资过程中，我发现系统化记录交易决策与反思对投资成长至关重要。市面上虽有许许多多投资管理工具，但大多过于复杂或缺乏个性化功能。",
      "paragraph2": "因此，我决定开发一个符合个人需求的投资日记系统，既能记录交易决策，又能追踪投资绩效，并提供即时提醒功能，帮助自己在投资路上不断学习与进步。"
    },
    "features": {
      "title": "主要功能",
      "subtitle": "为个人投资管理量身打造的功能",
      "diary": {
        "title": "投资日记",
        "description": "使用 Markdown 语法撰写详细的投资日记，记录交易理由、市场分析与个人反思，建立完整的投资决策记录。"
      },
      "calendar": {
        "title": "月历视图",
        "description": "以月历形式展示所有投资活动，直观查看每日的交易、日记与提醒，快速定位特定日期的投资纪录。"
      },
      "timeline": {
        "title": "时间轴",
        "description": "按时间顺序浏览所有投资记录，从时间轴中发现投资模式与决策变化，回顾投资历程。"
      },
      "stocks": {
        "title": "股票管理",
        "description": "追踪股票持仓、计算平均成本，使用 FIFO 先进先出法精确计算损益，掌握投资绩效。"
      },
      "alerts": {
        "title": "提醒系统",
        "description": "设定时间触发的个人提醒，确保不会错过重要的交易时机或市场事件。"
