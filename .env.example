# Database
DATABASE_URL="mysql://username:password@localhost:3306/invest_diary"

# Auth
JWT_SECRET="your-32-character-random-secret-key-change-this-in-production"

# App
NUXT_PUBLIC_APP_NAME="投資日記"
NUXT_PUBLIC_SITE_URL="https://trade-basic.com"

# SEC EDGAR automated access (application name + monitored contact email)
SEC_USER_AGENT="Trade Basic SEC Filings contact@example.com"

# Rate limiting — set "true" ONLY behind a trusted reverse proxy that appends the real client IP to X-Forwarded-For (the rate limiter then uses the last entry; otherwise the socket IP is used and XFF is ignored)
TRUST_X_FORWARDED_FOR="false"

# In-process schedulers and container migrations. Only one active
# realtime/scheduler instance may set SCHEDULER_ENABLED=true.
SCHEDULER_ENABLED="false"
RUN_MIGRATIONS="false"

# Structured logs: "json" for production log aggregation, "text" locally.
LOG_FORMAT="text"

# Bounded Yahoo market-data batch concurrency.
MARKET_DATA_CONCURRENCY="2"
