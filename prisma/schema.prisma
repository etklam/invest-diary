generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

enum DiaryCreatedVia {
  WEB
  API_KEY
  TELEGRAM_BOT
}

enum ApiKeyScope {
  DIARY_CREATE
  AGENT_WRITE
}

enum StockWatchStatus {
  WATCHING
  ARCHIVED
}

enum StockTimelineSourceType {
  TRADE_BASIC_DIARY
  VIDEO_TRANSCRIBE_SUMMARIZE
  DIARY
  ARTICLE
  MANUAL
  SYSTEM
}

enum StockTimelineCreatedVia {
  API_KEY
  WEB
  SYSTEM
}

enum StockNoteCreatedVia {
  USER
  AGENT
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  password     String   @db.VarChar(255)
  name         String?  @db.VarChar(100)
  role         UserRole @default(USER)
  tokenVersion Int      @default(0) @map("token_version")

  // User settings
  expectedMonthlyTrades Int     @default(20) @map("expected_monthly_trades")
  expectedProfit        Decimal @default(0) @map("expected_profit") @db.Decimal(15, 2)
  expectedAvgHolding    Decimal @default(0) @map("expected_avg_holding") @db.Decimal(15, 2)
  timezone              String  @default("Asia/Taipei") @db.VarChar(50)

  // Favorite tags (comma-separated)
  favoriteTagsString String? @map("favorite_tags") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  diaries               Diary[]
  disciplines           Discipline[]
  posts                 Post[]
  refreshTokens         RefreshToken[]
  etfWatchlist          EtfWatchlist[]
  apiKeys               ApiKeyCredential[]
  stockWatchlists       StockWatchlist[]
  stockTimelineRecords  StockTimelineRecord[]
  partnerLinksA         PartnerLink[]              @relation("PartnerLinkUserA")
  partnerLinksB         PartnerLink[]              @relation("PartnerLinkUserB")
  initiatedPartnerLinks PartnerLink[]              @relation("PartnerLinkInitiatedBy")
  priceAlerts           PriceAlert[]
  stockNotes            StockNote[]
  tradePlans            TradePlan[]
  diaryReconciliationAudits DiaryReconciliationAudit[]

  @@map("users")
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  token     String   @unique @db.VarChar(500)
  userId    BigInt   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_user_id_idx")
  @@index([token], map: "refresh_tokens_token_idx")
  @@map("refresh_tokens")
}

model Diary {
  id             BigInt          @id @default(autoincrement())
  userId         BigInt          @map("user_id")
  title          String          @db.VarChar(255)
  content        String?         @db.Text
  tagsString     String?         @map("tags") @db.VarChar(500)
  createdVia     DiaryCreatedVia @default(WEB) @map("created_via")
  createdByLabel String?         @map("created_by_label") @db.VarChar(100)
  date           DateTime        @default(now()) @map("date")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  // Structured review fields
  thesis       String?   @db.Text // Trading thesis / rationale
  risk         String?   @db.Text // Risk assessment
  execution    String?   @db.Text // Execution notes
  reviewDueAt  DateTime? @map("review_due_at") // When to review this diary
  reviewStatus String?   @default("none") @map("review_status") @db.VarChar(20) // none / pending / reviewed
  reviewedAt   DateTime? @map("reviewed_at") // When actually reviewed

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts               Alert[]
  transactions         Transaction[]
  stockTimelineRecords StockTimelineRecord[] @relation("StockTimelineSourceDiary")
  tradePlans           TradePlan[]

  @@index([userId], map: "diaries_user_id_fkey")
  // 複合索引：優化使用者日記列表查詢（按建立時間排序）
  @@index([userId, createdAt(sort: Desc)], map: "diaries_user_created_idx")
  // Diary.date is the normalized UTC-noon representation of the user-local civil date.
  @@unique([userId, date], map: "diaries_user_date_key")
  @@map("diaries")
}

model DiaryReconciliationAudit {
  id                         BigInt   @id @default(autoincrement())
  migrationId                String   @map("migration_id") @db.VarChar(100)
  userId                     BigInt   @map("user_id")
  diaryDate                  DateTime @map("diary_date")
  canonicalDiaryId           BigInt   @map("canonical_diary_id")
  mergedDiaryId              BigInt   @map("merged_diary_id")
  canonicalContentHashBefore String   @map("canonical_content_hash_before") @db.Char(64)
  mergedContentHashBefore    String   @map("merged_content_hash_before") @db.Char(64)
  canonicalContentHashAfter  String   @map("canonical_content_hash_after") @db.Char(64)
  transactionCount           Int      @map("transaction_count")
  alertCount                 Int      @map("alert_count")
  tradePlanCount             Int      @map("trade_plan_count")
  timelineRecordCount        Int      @map("timeline_record_count")
  createdAt                  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([migrationId, mergedDiaryId], map: "diary_reconciliation_audits_migration_merged_key")
  @@index([userId, diaryDate], map: "diary_reconciliation_audits_user_date_idx")
  @@map("diary_reconciliation_audits")
}

model TradePlan {
  id                    BigInt   @id @default(autoincrement())
  userId                BigInt   @map("user_id")
  diaryId               BigInt?  @map("diary_id")
  symbol                String   @db.VarChar(32)
  setupType             String?  @map("setup_type") @db.VarChar(100)
  entryPrice            Decimal? @map("entry_price") @db.Decimal(18, 6)
  entryZoneLow          Decimal? @map("entry_zone_low") @db.Decimal(18, 6)
  entryZoneHigh         Decimal? @map("entry_zone_high") @db.Decimal(18, 6)
  stopLoss              Decimal? @map("stop_loss") @db.Decimal(18, 6)
  targetPrice           Decimal? @map("target_price") @db.Decimal(18, 6)
  maxPositionSize       Decimal? @map("max_position_size") @db.Decimal(18, 2)
  invalidationCondition String?  @map("invalidation_condition") @db.Text
  notes                 String?  @db.Text
  status                String   @default("draft") @db.VarChar(32)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  diary Diary? @relation(fields: [diaryId], references: [id], onDelete: SetNull)

  @@index([userId, status], map: "trade_plans_user_status_idx")
  @@index([userId, symbol], map: "trade_plans_user_symbol_idx")
  @@index([diaryId], map: "trade_plans_diary_id_idx")
  @@map("trade_plans")
}

model PartnerLink {
  id                    BigInt    @id @default(autoincrement())
  userAId               BigInt    @map("user_a_id")
  userBId               BigInt    @map("user_b_id")
  initiatedByUserId     BigInt    @map("initiated_by_user_id")
  acceptedAt            DateTime? @map("accepted_at")
  userASharesDiaries    Boolean   @default(false) @map("user_a_shares_diaries")
  userBSharesDiaries    Boolean   @default(false) @map("user_b_shares_diaries")
  userASharesStockNotes Boolean   @default(false) @map("user_a_shares_stock_notes")
  userBSharesStockNotes Boolean   @default(false) @map("user_b_shares_stock_notes")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  userA           User @relation("PartnerLinkUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB           User @relation("PartnerLinkUserB", fields: [userBId], references: [id], onDelete: Cascade)
  initiatedByUser User @relation("PartnerLinkInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId], map: "partner_links_user_pair_key")
  @@index([userAId], map: "partner_links_user_a_idx")
  @@index([userBId], map: "partner_links_user_b_idx")
  @@index([initiatedByUserId], map: "partner_links_initiated_by_idx")
  @@map("partner_links")
}

model ApiKeyCredential {
  id         BigInt      @id @default(autoincrement())
  userId     BigInt      @map("user_id")
  label      String      @db.VarChar(100)
  keyHash    String      @unique @map("key_hash") @db.VarChar(255)
  keyPrefix  String      @map("key_prefix") @db.VarChar(24)
  scope      ApiKeyScope @default(DIARY_CREATE)
  lastUsedAt DateTime?   @map("last_used_at")
  revokedAt  DateTime?   @map("revoked_at")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt], map: "api_key_credentials_user_revoked_idx")
  @@index([keyPrefix], map: "api_key_credentials_key_prefix_idx")
  @@map("api_key_credentials")
}

model Alert {
  id             BigInt   @id @default(autoincrement())
  diaryId        BigInt   @map("diary_id")
  message        String   @db.VarChar(500)
  triggerAt      DateTime @map("trigger_at")
  isDismissed    Boolean  @default(false) @map("is_dismissed")
  recurringMode  String?  @map("recurring_mode") @db.VarChar(20)
  parentId       BigInt?  @map("parent_id")
  instanceNumber Int?     @default(1) @map("instance_number")
  isPaused       Boolean  @default(false) @map("is_paused")
  createdAt      DateTime @default(now()) @map("created_at")
  diary          Diary    @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@index([diaryId], map: "alerts_diary_id_fkey")
  @@index([parentId], map: "alerts_parent_id_idx")
  @@map("alerts")
}

model Discipline {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  content   String   @db.VarChar(255)
  order     Int      @default(0) @map("display_order")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "discipline_user_id_fkey")
  @@index([order], map: "discipline_order_idx")
  @@map("disciplines")
}

model Transaction {
  id        BigInt          @id @default(autoincrement())
  diaryId   BigInt          @map("diary_id")
  // 去正規化的 owner copy；授權真相永遠是 diary.userId
  userId    BigInt          @map("user_id")
  symbol    String          @db.VarChar(20)
  type      TransactionType
  quantity  Decimal         @db.Decimal(15, 4)
  price     Decimal         @db.Decimal(15, 4)
  tradeDate DateTime        @map("trade_date")
  // 交易後填寫欄位（柔性提示，非強制）
  notes     String?         @map("notes") @db.Text
  strategy  String?         @map("strategy") @db.VarChar(100)
  // 情緒狀態：VARCHAR 而非 ENUM，保留未來擴展彈性
  emotion   String?         @map("emotion") @db.VarChar(20)
  createdAt DateTime        @default(now()) @map("created_at")
  diary     Diary           @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@index([diaryId], map: "transactions_diary_id_fkey")
  // 複合索引：優化 holdings 查詢（按交易日期排序）
  @@index([symbol, tradeDate(sort: Asc)], map: "transactions_symbol_date_idx")
  // 複合索引：優化績效儀表板查詢（直接按 userId 查，不需 JOIN diary）
  @@index([userId, tradeDate(sort: Asc)], map: "transactions_user_date_idx")
  @@map("transactions")
}

enum TransactionType {
  BUY
  SELL
}

enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  CHANGE_PERCENT
  MOVING_AVG
}

model Post {
  id          BigInt     @id @default(autoincrement())
  authorId    BigInt     @map("author_id")
  title       String     @db.VarChar(255)
  slug        String     @unique @db.VarChar(255)
  content     String     @db.Text
  excerpt     String?    @db.Text
  coverImage  String?    @map("cover_image") @db.VarChar(500)
  category    String     @db.VarChar(100)
  tags        String?    @db.VarChar(500)
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?  @map("published_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId], map: "posts_author_id_idx")
  @@index([status], map: "posts_status_idx")
  @@index([publishedAt], map: "posts_published_at_idx")
  // 複合索引：優化已發布文章列表查詢（狀態 + 發布時間排序）
  @@index([status, publishedAt(sort: Desc)], map: "posts_status_published_idx")
  // 複合索引：優化分類查詢
  @@index([category, status], map: "posts_category_status_idx")
  // Note: Fulltext index for title/excerpt should be created via raw SQL migration
  @@map("posts")
}

model Etf {
  id     BigInt  @id @default(autoincrement())
  symbol String  @unique @db.VarChar(20)
  name   String? @db.VarChar(255)

  prices     EtfPrice[]
  watchlists EtfWatchlist[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([symbol], map: "etfs_symbol_idx")
  @@map("etfs")
}

model EtfPrice {
  id    BigInt   @id @default(autoincrement())
  etfId BigInt   @map("etf_id")
  date  DateTime @db.Date

  open     Decimal @db.Decimal(10, 4)
  high     Decimal @db.Decimal(10, 4)
  low      Decimal @db.Decimal(10, 4)
  close    Decimal @db.Decimal(10, 4)
  adjClose Decimal @map("adj_close") @db.Decimal(10, 4)
  volume   Int?    @map("volume")

  etf Etf @relation(fields: [etfId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([etfId, date], map: "etf_prices_etf_id_date_key")
  @@index([etfId, date(sort: Desc)], map: "etf_prices_etf_id_date_idx")
  @@map("etf_prices")
}

model EtfWatchlist {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  etfId     BigInt   @map("etf_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  etf  Etf  @relation(fields: [etfId], references: [id], onDelete: Cascade)

  @@unique([userId, etfId], map: "etf_watchlists_user_id_etf_id_key")
  @@index([userId, sortOrder], map: "etf_watchlists_user_id_sort_order_idx")
  @@map("etf_watchlists")
}

model Stock {
  id          BigInt   @id @default(autoincrement())
  symbol      String   @unique @db.VarChar(32)
  quoteSymbol String?  @map("quote_symbol") @db.VarChar(32)
  name        String?  @db.VarChar(255)
  exchange    String?  @db.VarChar(32)
  currency    String?  @db.VarChar(8)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  watchlists StockWatchlist[]
  records    StockTimelineRecord[]
  notes      StockNote[]

  @@index([symbol], map: "stocks_symbol_idx")
  @@map("stocks")
}

model StockWatchlist {
  id        BigInt           @id @default(autoincrement())
  userId    BigInt           @map("user_id")
  stockId   BigInt           @map("stock_id")
  status    StockWatchStatus @default(WATCHING)
  sortOrder Int              @default(0) @map("sort_order")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([userId, stockId], map: "stock_watchlists_user_stock_key")
  @@index([userId, status, sortOrder], map: "stock_watchlists_user_status_sort_idx")
  @@map("stock_watchlists")
}

model StockTimelineRecord {
  id               BigInt                  @id @default(autoincrement())
  userId           BigInt                  @map("user_id")
  stockId          BigInt                  @map("stock_id")
  summary          String                  @db.Text
  sourceType       StockTimelineSourceType @map("source_type")
  sourceTitle      String?                 @map("source_title") @db.VarChar(255)
  sourceUrl        String?                 @map("source_url") @db.VarChar(1000)
  sourceDiaryId    BigInt?                 @map("source_diary_id")
  sourceExternalId String?                 @map("source_external_id") @db.VarChar(255)
  sourceExcerpt    String?                 @map("source_excerpt") @db.Text
  confidence       Int?                    @db.UnsignedTinyInt
  idempotencyKey   String                  @map("idempotency_key") @db.VarChar(128)
  occurredAt       DateTime                @map("occurred_at")
  createdVia       StockTimelineCreatedVia @default(API_KEY) @map("created_via")
  createdByLabel   String?                 @map("created_by_label") @db.VarChar(100)
  metadataJson     String?                 @map("metadata_json") @db.Text
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock       Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)
  sourceDiary Diary? @relation("StockTimelineSourceDiary", fields: [sourceDiaryId], references: [id], onDelete: SetNull)

  @@unique([userId, stockId, idempotencyKey], map: "stock_timeline_records_user_stock_idempotency_key")
  @@index([userId, stockId, occurredAt(sort: Desc)], map: "stock_timeline_records_user_stock_time_idx")
  @@index([userId, occurredAt(sort: Desc)], map: "stock_timeline_records_user_time_idx")
  @@index([sourceType, sourceExternalId], map: "stock_timeline_records_source_external_idx")
  @@index([sourceDiaryId], map: "stock_timeline_records_source_diary_idx")
  @@map("stock_timeline_records")
}

// ─── StockNote: 股票日記系統 ─────────────────────────────────────────────────

model StockNote {
  id             BigInt              @id @default(autoincrement())
  userId         BigInt              @map("user_id")
  stockId        BigInt              @map("stock_id")
  title          String              @db.VarChar(255)
  content        String              @db.Text
  date           DateTime            @default(now())
  createdVia     StockNoteCreatedVia @default(USER) @map("created_via")
  createdByLabel String?             @map("created_by_label") @db.VarChar(100)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([userId, stockId, date(sort: Desc)], map: "stock_notes_user_stock_date_idx")
  @@index([stockId, date(sort: Desc)], map: "stock_notes_stock_date_idx")
  @@map("stock_notes")
}

// ─── Phase 6.1: Stock Price Alerts ────────────────────────────────────────────

// ─── Stock Price Alerts ──────────────────────────────────────────────────────

model PriceAlert {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @map("user_id")
  symbol      String    @db.VarChar(20)
  type        AlertType
  threshold   Decimal   @db.Decimal(10, 4)
  message     String    @db.VarChar(500)
  isTriggered Boolean   @default(false) @map("is_triggered")
  triggeredAt DateTime? @map("triggered_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isTriggered])
  @@index([symbol, isTriggered])
  @@map("price_alerts")
}

// ─── Market State Regime Monitor ───────────────────────────────────────────────

model MarketUniverse {
  id        BigInt   @id @default(autoincrement())
  symbol    String   @unique @db.VarChar(20)
  name      String   @db.VarChar(255)
  exchange  String   @db.VarChar(32)
  assetType String   @map("asset_type") @db.VarChar(32)
  isActive  Boolean  @default(true) @map("is_active")
  sector    String?  @db.VarChar(100)
  updatedAt DateTime @default(now()) @map("updated_at")

  @@index([symbol], map: "market_universe_symbol_idx")
  @@index([isActive, assetType], map: "market_universe_active_asset_type_idx")
  @@index([exchange, isActive], map: "market_universe_exchange_active_idx")
  @@map("market_universe")
}

model MarketBreadthDaily {
  id            BigInt   @id @default(autoincrement())
  universeKey   String   @map("universe_key") @db.VarChar(32)
  date          DateTime @db.Date
  universeCount Int      @map("universe_count")
  up4Count      Int?     @map("up4_count")
  down4Count    Int?     @map("down4_count")
  up4Pct        Decimal? @map("up4_pct") @db.Decimal(8, 4)
  down4Pct      Decimal? @map("down4_pct") @db.Decimal(8, 4)
  above40dCount Int?     @map("above40d_count")
  above40dPct   Decimal? @map("above40d_pct") @db.Decimal(8, 4)
  ratio5d       Decimal? @map("ratio_5d") @db.Decimal(12, 4)
  ratio10d      Decimal? @map("ratio_10d") @db.Decimal(12, 4)
  regime        String?  @db.VarChar(32)
  score         Int?
  coveragePct   Decimal? @map("coverage_pct") @db.Decimal(5, 2)
  isStale       Boolean  @default(false) @map("is_stale")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([universeKey, date], map: "market_breadth_daily_universe_date_key")
  @@index([universeKey, date(sort: Desc)], map: "market_breadth_daily_universe_date_idx")
  @@map("market_breadth_daily")
}

model MarketDailyPrice {
  id            BigInt   @id @default(autoincrement())
  symbol        String   @db.VarChar(20)
  date          DateTime @db.Date
  open          Decimal  @db.Decimal(18, 6)
  high          Decimal  @db.Decimal(18, 6)
  low           Decimal  @db.Decimal(18, 6)
  close         Decimal  @db.Decimal(18, 6)
  adjustedClose Decimal  @map("adjusted_close") @db.Decimal(18, 6)
  volume        BigInt
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([symbol, date], map: "market_daily_price_symbol_date_key")
  @@index([symbol, date], map: "market_daily_price_symbol_date_idx")
  @@index([date], map: "market_daily_price_date_idx")
  @@map("market_daily_price")
}

model MarketRotationSnapshotRun {
  id                   BigInt    @id @default(autoincrement())
  rankScope            String    @map("rank_scope") @db.VarChar(20)
  snapshotDate         DateTime? @map("snapshot_date") @db.Date
  status               String    @db.VarChar(32)
  symbolCount          Int       @default(0) @map("symbol_count")
  qualifiedSymbolCount Int       @default(0) @map("qualified_symbol_count")
  upsertedCount        Int       @default(0) @map("upserted_count")
  errorCount           Int       @default(0) @map("error_count")
  errorMessage         String?   @map("error_message") @db.Text
  startedAt            DateTime  @default(now()) @map("started_at")
  finishedAt           DateTime? @map("finished_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([rankScope, startedAt(sort: Desc)], map: "market_rotation_snapshot_run_scope_started_idx")
  @@index([snapshotDate], map: "market_rotation_snapshot_run_snapshot_date_idx")
  @@map("market_rotation_snapshot_run")
}

model MarketRotationSnapshot {
  id                              BigInt   @id @default(autoincrement())
  date                            DateTime @db.Date
  symbol                          String   @db.VarChar(20)
  rankScope                       String   @map("rank_scope") @db.VarChar(20)
  groupType                       String   @map("group_type") @db.VarChar(20)
  sectorName                      String?  @map("sector_name") @db.VarChar(100)
  lastPrice                       Decimal? @map("last_price") @db.Decimal(18, 6)
  adjustedClose                   Decimal? @map("adjusted_close") @db.Decimal(18, 6)
  dailyChangePct                  Decimal? @map("daily_change_pct") @db.Decimal(10, 4)
  weeklyChangePct                 Decimal? @map("weekly_change_pct") @db.Decimal(10, 4)
  twoWeekPerformancePct           Decimal? @map("two_week_performance_pct") @db.Decimal(10, 4)
  rsi14                           Decimal? @db.Decimal(8, 4)
  rsiPercentile                   Decimal? @map("rsi_percentile") @db.Decimal(8, 4)
  rsiDelta2W                      Decimal? @map("rsi_delta_2w") @db.Decimal(8, 4)
  ema10                           Decimal? @db.Decimal(18, 6)
  ema20                           Decimal? @db.Decimal(18, 6)
  sma50                           Decimal? @db.Decimal(18, 6)
  sma200                          Decimal? @db.Decimal(18, 6)
  above10d                        Boolean?
  above20d                        Boolean?
  above50d                        Boolean?
  above200d                       Boolean?
  maScore                         Int?     @map("ma_score")
  maScorePercentile               Decimal? @map("ma_score_percentile") @db.Decimal(8, 4)
  maStatus                        String?  @map("ma_status") @db.VarChar(32)
  rolling252dHigh                 Decimal? @map("rolling_252d_high") @db.Decimal(18, 6)
  percentFromHigh                 Decimal? @map("percent_from_high") @db.Decimal(10, 4)
  distanceFromHighScore           Decimal? @map("distance_from_high_score") @db.Decimal(8, 4)
  distanceFromHighScorePercentile Decimal? @map("distance_from_high_score_percentile") @db.Decimal(8, 4)
  rotationScore                   Decimal? @map("rotation_score") @db.Decimal(8, 4)
  rotationScoreDelta2W            Decimal? @map("rotation_score_delta_2w") @db.Decimal(8, 4)
  rotationRank                    Int?     @map("rotation_rank")
  rankDelta2W                     Int?     @map("rank_delta_2w")
  signal                          String?  @db.VarChar(32)
  signalStatus                    String   @map("signal_status") @db.VarChar(32)
  createdAt                       DateTime @default(now()) @map("created_at")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  @@unique([rankScope, symbol, date], map: "market_rotation_snapshot_scope_symbol_date_key")
  @@index([rankScope, date, rotationRank], map: "market_rotation_snapshot_scope_date_rank_idx")
  @@index([rankScope, date], map: "market_rotation_snapshot_scope_date_idx")
  @@map("market_rotation_snapshot")
}
