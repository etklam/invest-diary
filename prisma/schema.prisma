generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                    BigInt    @id @default(autoincrement())
  email                 String    @unique @db.VarChar(255)
  password              String    @db.VarChar(255)
  name                  String?   @db.VarChar(100)
  role                  UserRole  @default(USER)

  // User settings
  expectedMonthlyTrades Int       @default(20) @map("expected_monthly_trades")
  expectedProfit        Decimal   @default(0) @db.Decimal(15, 2) @map("expected_profit")
  expectedAvgHolding    Decimal   @default(0) @db.Decimal(15, 2) @map("expected_avg_holding")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  diaries               Diary[]
  disciplines           Discipline[]
  posts                 Post[]

  @@map("users")
}

model Diary {
  id           BigInt        @id @default(autoincrement())
  userId       BigInt        @map("user_id")
  title        String        @db.VarChar(255)
  content      String?       @db.Text
  date         DateTime      @default(now()) @map("date")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts       Alert[]
  transactions Transaction[]

  @@index([userId], map: "diaries_user_id_fkey")
  @@map("diaries")
}

model Alert {
  id          BigInt   @id @default(autoincrement())
  diaryId     BigInt   @map("diary_id")
  message     String   @db.VarChar(500)
  triggerAt   DateTime @map("trigger_at")
  isDismissed Boolean  @default(false) @map("is_dismissed")
  createdAt   DateTime @default(now()) @map("created_at")
  diary       Diary    @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@index([diaryId], map: "alerts_diary_id_fkey")
  @@map("alerts")
}

model Discipline {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  content   String  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "discipline_user_id_fkey")
  @@map("disciplines")
}

model Transaction {
  id        BigInt          @id @default(autoincrement())
  diaryId   BigInt          @map("diary_id")
  symbol    String          @db.VarChar(20)
  type      TransactionType
  quantity  Decimal         @db.Decimal(15, 4)
  price     Decimal         @db.Decimal(15, 4)
  tradeDate DateTime        @map("trade_date")
  createdAt DateTime        @default(now()) @map("created_at")
  diary     Diary           @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@index([diaryId], map: "transactions_diary_id_fkey")
  @@map("transactions")
}

enum TransactionType {
  BUY
  SELL
}

model Post {
  id          BigInt       @id @default(autoincrement())
  authorId    BigInt       @map("author_id")
  title       String       @db.VarChar(255)
  slug        String       @unique @db.VarChar(255)
  content     String       @db.Text
  excerpt     String?      @db.Text
  coverImage  String?      @db.VarChar(500) @map("cover_image")
  category    String       @db.VarChar(100)
  tags        String?      @db.VarChar(500)
  status      PostStatus   @default(DRAFT)
  publishedAt DateTime?    @map("published_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId], map: "posts_author_id_idx")
  @@index([status], map: "posts_status_idx")
  @@index([publishedAt], map: "posts_published_at_idx")
  @@map("posts")
}
