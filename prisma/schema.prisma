generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

enum DiaryCreatedVia {
  WEB
  API_KEY
  TELEGRAM_BOT
}

enum ApiKeyScope {
  DIARY_CREATE
  AGENT_WRITE
}

enum StockWatchStatus {
  WATCHING
  ARCHIVED
}

enum StockTimelineSourceType {
  TRADE_BASIC_DIARY
  VIDEO_TRANSCRIBE_SUMMARIZE
  DIARY
  ARTICLE
  MANUAL
  SYSTEM
}

enum StockTimelineCreatedVia {
  API_KEY
  WEB
  SYSTEM
}

enum StockNoteCreatedVia {
  USER
  AGENT
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                    BigInt        @id @default(autoincrement())
  email                 String        @unique @db.VarChar(255)
  password              String        @db.VarChar(255)
  name                  String?       @db.VarChar(100)
  role                  UserRole      @default(USER)
  tokenVersion          Int           @default(0) @map("token_version")

  // User settings
  expectedMonthlyTrades Int           @default(20) @map("expected_monthly_trades")
  expectedProfit        Decimal       @default(0) @db.Decimal(15, 2) @map("expected_profit")
  expectedAvgHolding    Decimal       @default(0) @db.Decimal(15, 2) @map("expected_avg_holding")
  timezone              String        @default("Asia/Taipei") @db.VarChar(50)

  // Favorite tags (comma-separated)
  favoriteTagsString    String?       @map("favorite_tags") @db.VarChar(500)

  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  diaries               Diary[]
  disciplines           Discipline[]
  posts                 Post[]
  refreshTokens         RefreshToken[]
  etfWatchlist          EtfWatchlist[]
  apiKeys               ApiKeyCredential[]
  stockWatchlists       StockWatchlist[]
  stockTimelineRecords  StockTimelineRecord[]
  partnerLinksA         PartnerLink[]   @relation("PartnerLinkUserA")
  partnerLinksB         PartnerLink[]   @relation("PartnerLinkUserB")
  initiatedPartnerLinks PartnerLink[]   @relation("PartnerLinkInitiatedBy")
  priceAlerts           PriceAlert[]
  stockNotes            StockNote[]
  telegramAccounts      TelegramAccount[]
  verificationCodes     TelegramVerificationCode[]

  @@map("users")
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  token     String   @unique @db.VarChar(500)
  userId    BigInt   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_user_id_idx")
  @@index([token], map: "refresh_tokens_token_idx")
  @@map("refresh_tokens")
}

model Diary {
  id           BigInt        @id @default(autoincrement())
  userId       BigInt        @map("user_id")
  title        String        @db.VarChar(255)
  content      String?       @db.Text
  tagsString   String?       @map("tags") @db.VarChar(500)
  createdVia   DiaryCreatedVia @default(WEB) @map("created_via")
  createdByLabel String?     @map("created_by_label") @db.VarChar(100)
  date         DateTime      @default(now()) @map("date")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts       Alert[]
  transactions Transaction[]
  stockTimelineRecords StockTimelineRecord[] @relation("StockTimelineSourceDiary")

  @@index([userId], map: "diaries_user_id_fkey")
  // 複合索引：優化使用者日記列表查詢（按建立時間排序）
  @@index([userId, createdAt(sort: Desc)], map: "diaries_user_created_idx")
  @@map("diaries")
}

model PartnerLink {
  id                 BigInt   @id @default(autoincrement())
  userAId            BigInt   @map("user_a_id")
  userBId            BigInt   @map("user_b_id")
  initiatedByUserId  BigInt   @map("initiated_by_user_id")
  acceptedAt         DateTime? @map("accepted_at")
  userASharesDiaries Boolean  @default(false) @map("user_a_shares_diaries")
  userBSharesDiaries Boolean  @default(false) @map("user_b_shares_diaries")
  userASharesStockNotes Boolean  @default(false) @map("user_a_shares_stock_notes")
  userBSharesStockNotes Boolean  @default(false) @map("user_b_shares_stock_notes")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  userA             User     @relation("PartnerLinkUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB             User     @relation("PartnerLinkUserB", fields: [userBId], references: [id], onDelete: Cascade)
  initiatedByUser   User     @relation("PartnerLinkInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId], map: "partner_links_user_pair_key")
  @@index([userAId], map: "partner_links_user_a_idx")
  @@index([userBId], map: "partner_links_user_b_idx")
  @@index([initiatedByUserId], map: "partner_links_initiated_by_idx")
  @@map("partner_links")
}

model ApiKeyCredential {
  id          BigInt      @id @default(autoincrement())
  userId      BigInt      @map("user_id")
  label       String      @db.VarChar(100)
  keyHash     String      @unique @map("key_hash") @db.VarChar(255)
  keyPrefix   String      @map("key_prefix") @db.VarChar(24)
  scope       ApiKeyScope @default(DIARY_CREATE)
  lastUsedAt  DateTime?   @map("last_used_at")
  revokedAt   DateTime?   @map("revoked_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt], map: "api_key_credentials_user_revoked_idx")
  @@index([keyPrefix], map: "api_key_credentials_key_prefix_idx")
  @@map("api_key_credentials")
}

model Alert {
  id             BigInt   @id @default(autoincrement())
  diaryId        BigInt   @map("diary_id")
  message        String   @db.VarChar(500)
  triggerAt      DateTime @map("trigger_at")
  isDismissed    Boolean  @default(false) @map("is_dismissed")
  recurringMode  String?  @db.VarChar(20) @map("recurring_mode")
  parentId       BigInt?  @map("parent_id")
  instanceNumber Int?     @default(1) @map("instance_number")
  isPaused       Boolean  @default(false) @map("is_paused")
  createdAt      DateTime @default(now()) @map("created_at")
  diary          Diary    @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@index([diaryId], map: "alerts_diary_id_fkey")
  @@index([parentId], map: "alerts_parent_id_idx")
  @@map("alerts")
}

model Discipline {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  content   String   @db.VarChar(255)
  order     Int      @default(0) @map("display_order")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "discipline_user_id_fkey")
  @@index([order], map: "discipline_order_idx")
  @@map("disciplines")
}


model Transaction {
  id        BigInt          @id @default(autoincrement())
  diaryId   BigInt          @map("diary_id")
  // 去正規化 FK，避免每次都要 JOIN diary 表，優化績效查詢
  userId    BigInt?         @map("user_id")
  symbol    String          @db.VarChar(20)
  type      TransactionType
  quantity  Decimal         @db.Decimal(15, 4)
  price     Decimal         @db.Decimal(15, 4)
  tradeDate DateTime        @map("trade_date")
  // 交易後填寫欄位（柔性提示，非強制）
  notes     String?         @db.Text @map("notes")
  strategy  String?         @db.VarChar(100) @map("strategy")
  // 情緒狀態：VARCHAR 而非 ENUM，保留未來擴展彈性
  emotion   String?         @db.VarChar(20) @map("emotion")
  createdAt DateTime        @default(now()) @map("created_at")
  diary     Diary           @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@index([diaryId], map: "transactions_diary_id_fkey")
  // 複合索引：優化 holdings 查詢（按交易日期排序）
  @@index([symbol, tradeDate(sort: Asc)], map: "transactions_symbol_date_idx")
  // 複合索引：優化績效儀表板查詢（直接按 userId 查，不需 JOIN diary）
  @@index([userId, tradeDate(sort: Asc)], map: "transactions_user_date_idx")
  @@map("transactions")
}

enum TransactionType {
  BUY
  SELL
}

enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  CHANGE_PERCENT
  MOVING_AVG
}

model Post {
  id          BigInt       @id @default(autoincrement())
  authorId    BigInt       @map("author_id")
  title       String       @db.VarChar(255)
  slug        String       @unique @db.VarChar(255)
  content     String       @db.Text
  excerpt     String?      @db.Text
  coverImage  String?      @db.VarChar(500) @map("cover_image")
  category    String       @db.VarChar(100)
  tags        String?      @db.VarChar(500)
  status      PostStatus   @default(DRAFT)
  publishedAt DateTime?    @map("published_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId], map: "posts_author_id_idx")
  @@index([status], map: "posts_status_idx")
  @@index([publishedAt], map: "posts_published_at_idx")
  // 複合索引：優化已發布文章列表查詢（狀態 + 發布時間排序）
  @@index([status, publishedAt(sort: Desc)], map: "posts_status_published_idx")
  // 複合索引：優化分類查詢
  @@index([category, status], map: "posts_category_status_idx")
  // Note: Fulltext index for title/excerpt should be created via raw SQL migration
  @@map("posts")
}

model Etf {
  id          BigInt        @id @default(autoincrement())
  symbol      String        @unique @db.VarChar(20)
  name        String?       @db.VarChar(255)

  prices      EtfPrice[]
  watchlists  EtfWatchlist[]

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([symbol], map: "etfs_symbol_idx")
  @@map("etfs")
}

model EtfPrice {
  id          BigInt       @id @default(autoincrement())
  etfId       BigInt       @map("etf_id")
  date        DateTime     @db.Date

  open        Decimal      @db.Decimal(10, 4)
  high        Decimal      @db.Decimal(10, 4)
  low         Decimal      @db.Decimal(10, 4)
  close       Decimal      @db.Decimal(10, 4)
  adjClose    Decimal      @db.Decimal(10, 4) @map("adj_close")
  volume      Int?         @map("volume")

  etf         Etf          @relation(fields: [etfId], references: [id], onDelete: Cascade)

  createdAt   DateTime     @default(now()) @map("created_at")

  @@unique([etfId, date], map: "etf_prices_etf_id_date_key")
  @@index([etfId, date(sort: Desc)], map: "etf_prices_etf_id_date_idx")
  @@map("etf_prices")
}

model EtfWatchlist {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  etfId      BigInt   @map("etf_id")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  etf        Etf      @relation(fields: [etfId], references: [id], onDelete: Cascade)

  @@unique([userId, etfId], map: "etf_watchlists_user_id_etf_id_key")
  @@index([userId, sortOrder], map: "etf_watchlists_user_id_sort_order_idx")
  @@map("etf_watchlists")
}

model Stock {
  id          BigInt   @id @default(autoincrement())
  symbol      String   @unique @db.VarChar(32)
  quoteSymbol String?  @map("quote_symbol") @db.VarChar(32)
  name        String?  @db.VarChar(255)
  exchange    String?  @db.VarChar(32)
  currency    String?  @db.VarChar(8)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  watchlists  StockWatchlist[]
  records     StockTimelineRecord[]
  notes       StockNote[]

  @@index([symbol], map: "stocks_symbol_idx")
  @@map("stocks")
}

model StockWatchlist {
  id        BigInt           @id @default(autoincrement())
  userId    BigInt           @map("user_id")
  stockId   BigInt           @map("stock_id")
  status    StockWatchStatus @default(WATCHING)
  sortOrder Int              @default(0) @map("sort_order")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock     Stock            @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([userId, stockId], map: "stock_watchlists_user_stock_key")
  @@index([userId, status, sortOrder], map: "stock_watchlists_user_status_sort_idx")
  @@map("stock_watchlists")
}

model StockTimelineRecord {
  id               BigInt                  @id @default(autoincrement())
  userId           BigInt                  @map("user_id")
  stockId          BigInt                  @map("stock_id")
  summary          String                  @db.Text
  sourceType       StockTimelineSourceType @map("source_type")
  sourceTitle      String?                 @map("source_title") @db.VarChar(255)
  sourceUrl        String?                 @map("source_url") @db.VarChar(1000)
  sourceDiaryId    BigInt?                 @map("source_diary_id")
  sourceExternalId String?                 @map("source_external_id") @db.VarChar(255)
  sourceExcerpt    String?                 @map("source_excerpt") @db.Text
  confidence       Int?                    @db.UnsignedTinyInt
  idempotencyKey   String                  @map("idempotency_key") @db.VarChar(128)
  occurredAt       DateTime                @map("occurred_at")
  createdVia       StockTimelineCreatedVia @default(API_KEY) @map("created_via")
  createdByLabel   String?                 @map("created_by_label") @db.VarChar(100)
  metadataJson     String?                 @map("metadata_json") @db.Text
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock            Stock                   @relation(fields: [stockId], references: [id], onDelete: Cascade)
  sourceDiary      Diary?                  @relation("StockTimelineSourceDiary", fields: [sourceDiaryId], references: [id], onDelete: SetNull)

  @@unique([userId, stockId, idempotencyKey], map: "stock_timeline_records_user_stock_idempotency_key")
  @@index([userId, stockId, occurredAt(sort: Desc)], map: "stock_timeline_records_user_stock_time_idx")
  @@index([userId, occurredAt(sort: Desc)], map: "stock_timeline_records_user_time_idx")
  @@index([sourceType, sourceExternalId], map: "stock_timeline_records_source_external_idx")
  @@index([sourceDiaryId], map: "stock_timeline_records_source_diary_idx")
  @@map("stock_timeline_records")
}

// ─── StockNote: 股票日記系統 ─────────────────────────────────────────────────

model StockNote {
  id             BigInt               @id @default(autoincrement())
  userId         BigInt               @map("user_id")
  stockId        BigInt               @map("stock_id")
  title          String               @db.VarChar(255)
  content        String               @db.Text
  date           DateTime             @default(now())
  createdVia     StockNoteCreatedVia  @default(USER) @map("created_via")
  createdByLabel String?              @map("created_by_label") @db.VarChar(100)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock          Stock                @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([userId, stockId, date(sort: Desc)], map: "stock_notes_user_stock_date_idx")
  @@index([stockId, date(sort: Desc)], map: "stock_notes_stock_date_idx")
  @@map("stock_notes")
}


// ─── Phase 6.1: Stock Price Alerts ────────────────────────────────────────────

// ─── Telegram Bot ───────────────────────────────────────────────────────────

model TelegramAccount {
  id            Int      @id @default(autoincrement())
  telegramId    BigInt   @unique @map("telegram_id")
  userId        BigInt   @map("user_id")
  username      String?  @db.VarChar(100)
  firstName     String?  @map("first_name") @db.VarChar(100)
  lastName      String?  @map("last_name") @db.VarChar(100)
  language      String   @default("zh-TW") @db.VarChar(10)
  linkedAt      DateTime @default(now()) @map("linked_at")
  lastActiveAt  DateTime @default(now()) @map("last_active_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([telegramId])
  @@map("telegram_accounts")
}

model TelegramSession {
  id        String   @id @db.VarChar(255)
  key       String   @db.VarChar(255)
  value     Json
  expiresAt DateTime @map("expires_at")

  @@index([key])
  @@index([expiresAt])
  @@map("telegram_sessions")
}

model TelegramVerificationCode {
  id        Int      @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  code      String   @unique @db.VarChar(10)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@map("telegram_verification_codes")
}

model TelegramProcessedUpdate {
  updateId    Int      @id @map("update_id")
  processedAt DateTime @default(now()) @map("processed_at")
  action      String   @db.VarChar(50)

  @@map("telegram_processed_updates")
}

// ─── Stock Price Alerts ──────────────────────────────────────────────────────

model PriceAlert {
  id          BigInt     @id @default(autoincrement())
  userId      BigInt     @map("user_id")
  symbol      String     @db.VarChar(20)
  type        AlertType
  threshold   Decimal    @db.Decimal(10, 4)
  message     String     @db.VarChar(500)
  isTriggered Boolean    @default(false) @map("is_triggered")
  triggeredAt DateTime?  @map("triggered_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isTriggered])
  @@index([symbol, isTriggered])
  @@map("price_alerts")
}
